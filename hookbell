#!/bin/bash
# hookbell: native macOS notifications per source (own name + icon) that jump back to the sender on click.
#   hookbell install                                  build and link to ~/.local/bin
#   hookbell hooks <codex|claude-code|gemini|agy|all> add the source and register its hooks
#   hookbell unhook <tool|all> | uninstall            remove hooks / everything
#   hookbell send <source> --title T [--body B] [...] options: see main.swift
#   hookbell hook <source> [PAYLOAD]                  hook payload from argv (Codex) or stdin
#   hookbell add <source> <name> <icon.png|.icns> | authorize <source> | remove <source> | list | version
set -euo pipefail

VERSION=0.1.0
ROOT="$HOME/Library/Application Support/hookbell"
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
CLI="$HOME/.local/bin/hookbell"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
GENERIC_ICON=/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/GenericApplicationIcon.icns
TOOLS=(codex claude-code gemini agy)

die() { echo "hookbell: $*" >&2; exit 1; }
check_id() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "invalid source id '${1:-}' (a-z, 0-9, -)"; }
bundle() { echo "$ROOT/Sources/$1.app"; }
binary() { echo "$(bundle "$1")/Contents/MacOS/hookbell"; }
sign() { codesign --force --sign - "$1" >/dev/null 2>&1 && "$LSREGISTER" -f "$1"; }
# A tool counts as installed when its command or its config folder exists.
installed() {
  case "$1" in
  codex) command -v codex || [ -d "${CODEX_HOME:-$HOME/.codex}" ] ;;
  claude-code) command -v claude || [ -d "$HOME/.claude" ] ;;
  gemini) command -v gemini || [ -f "$HOME/.gemini/settings.json" ] ;;
  agy) command -v agy || [ -d "$HOME/.gemini/antigravity-cli" ] ;;
  esac >/dev/null
}
# "all" selects every installed tool for hooks and every supported tool for unhook.
select_tools() {
  local mode="$1"
  shift
  [ "${1:-}" = all ] || { echo "$@"; return; }
  for tool in "${TOOLS[@]}"; do
    if [ "$mode" = unhook ] || installed "$tool"; then echo "$tool"; fi
  done
}

# Display name and the bundle id of the app whose icon the source borrows.
tool_info() {
  case "$1" in
  codex) echo "Codex|com.openai.codex" ;;
  claude-code) echo "Claude Code|com.anthropic.claudefordesktop" ;;
  gemini) echo "Gemini CLI|com.google.GeminiMacOS" ;;
  agy) echo "Antigravity|com.google.antigravity" ;;
  *) die "unknown tool '$1' (codex, claude-code, gemini, agy, all)" ;;
  esac
}

app_icon() {
  local app icon
  app="$(mdfind "kMDItemCFBundleIdentifier == '$1'" 2>/dev/null | head -1)"
  if [ -n "$app" ]; then
    icon="$(plutil -extract CFBundleIconFile raw "$app/Contents/Info.plist" 2>/dev/null || true)"
    icon="$app/Contents/Resources/${icon%.icns}.icns"
    if [ -f "$icon" ]; then echo "$icon"; return; fi
  fi
  echo "$GENERIC_ICON"
}

# Adds or removes hookbell's entries in a tool's hook config; other entries stay untouched.
patch_config() {
  python3 -I - "$1" "$2" "$CLI" <<'PY'
import json, os, re, shutil, sys

action, tool, cli = sys.argv[1:4]
cmd = f'"$HOME/.local/bin/hookbell" hook {tool}'
mine = lambda h: isinstance(h, dict) and f'hookbell" hook {tool}' in h.get("command", "")

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}

def save(path, data, original):
    if data == original:
        return
    if os.path.exists(path):
        shutil.copy2(path, path + ".hookbell.bak")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    print(f"updated {path}")

EVENTS = {
    "claude-code": ("~/.claude/settings.json", [("Stop", None), ("Notification", ""), ("PreToolUse", "AskUserQuestion")]),
    "gemini": ("~/.gemini/settings.json", [("AfterAgent", "*"), ("Notification", "*"), ("BeforeTool", "ask_user")]),
}

if tool in EVENTS:
    path, events = EVENTS[tool]
    path = os.path.expanduser(path)
    original = load(path)
    data = json.loads(json.dumps(original))
    hooks = data.setdefault("hooks", {})
    for event, entries in list(hooks.items()):
        if not isinstance(entries, list):
            continue
        kept = []
        for entry in entries:
            handlers = [h for h in entry.get("hooks", []) if not mine(h)]
            if handlers or len(handlers) == len(entry.get("hooks", [])):
                kept.append({**entry, "hooks": handlers})
        hooks[event] = kept
        if not kept:
            del hooks[event]
    if action == "install":
        for event, matcher in events:
            entry = {"hooks": [{"type": "command", "command": cmd}]}
            hooks.setdefault(event, []).append(entry if matcher is None else {"matcher": matcher, **entry})
    if not hooks:
        del data["hooks"]
    save(path, data, original)

elif tool == "agy":
    path = os.path.expanduser("~/.gemini/config/hooks.json")
    original = load(path)
    data = {k: v for k, v in original.items() if k != "hookbell"}
    if action == "install":
        handler = {"type": "command", "command": cmd, "timeout": 15}
        data["hookbell"] = {"Stop": [handler], "PreToolUse": [{"matcher": "ask_question|notify_user", "hooks": [handler]}]}
    save(path, data, original)

elif tool == "codex":
    # Codex runs exactly one notify command and starts it without a shell, so the path is absolute.
    path = os.path.join(os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex")), "config.toml")
    text = open(path).read() if os.path.exists(path) else ""
    line = f'notify = ["{cli}", "hook", "codex"]'
    current = re.search(r"^notify\s*=.*$", text, re.M)
    if action == "install":
        if current and "hookbell" in current.group(0):
            sys.exit(0)
        if current:
            sys.exit(f"hookbell: {path} already has a notify command and Codex runs only one; replace it with:\n  {line}")
        new = line + "\n" + text
    else:
        if not current or "hookbell" not in current.group(0):
            sys.exit(0)
        if current.group(0) != line:
            sys.exit(f"hookbell: {path} calls hookbell inside a custom notify command; remove it there by hand")
        new = text.replace(line + "\n", "", 1)
    if os.path.exists(path):
        shutil.copy2(path, path + ".hookbell.bak")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    open(path, "w").write(new)
    print(f"updated {path}")
PY
}

[ "$(id -u)" -ne 0 ] || die "do not run as root"

case "${1:-}" in
send)
  check_id "${2:-}"
  [ $# -gt 2 ] || die "usage: hookbell send <source> --title T [--body B] [...]"
  [ -x "$(binary "$2")" ] || die "unknown source '$2'; add it with: hookbell add $2 <name> <icon>"
  bin="$(binary "$2")"
  shift 2
  exec "$bin" "$@"
  ;;
hook)
  check_id "${2:-}"
  [ -x "$(binary "$2")" ] || die "unknown source '$2'; run: hookbell hooks $2"
  exec "$(binary "$2")" --hook "${3:-}" "${@:4}"
  ;;
install)
  mkdir -p "$ROOT/Sources" "$(dirname "$CLI")"
  swiftc -O -o "$ROOT/hookbell.new" "$REPO/main.swift"
  mv "$ROOT/hookbell.new" "$ROOT/hookbell"
  for app in "$ROOT"/Sources/*.app; do
    [ -d "$app" ] || continue
    cp "$ROOT/hookbell" "$app/Contents/MacOS/hookbell"
    sign "$app"
  done
  ln -sf "$REPO/hookbell" "$CLI"
  echo "installed hookbell $VERSION ($CLI)"
  ;;
add)
  check_id "${2:-}"
  name="${3:-}" icon="${4:-}"
  [ -n "$name" ] || die "display name missing"
  [ -f "$icon" ] || die "icon not found: $icon"
  [ -x "$ROOT/hookbell" ] || die "run 'hookbell install' first"
  app="$(bundle "$2")"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/x.app/Contents/MacOS" "$tmp/x.app/Contents/Resources"
  cp "$ROOT/hookbell" "$tmp/x.app/Contents/MacOS/hookbell"
  if [[ "$icon" == *.icns ]]; then
    cp "$icon" "$tmp/x.app/Contents/Resources/AppIcon.icns"
  else
    mkdir "$tmp/i.iconset"
    for s in 16 32 128 256 512; do
      sips -s format png -z "$s" "$s" "$icon" --out "$tmp/i.iconset/icon_${s}x${s}.png" >/dev/null
      sips -s format png -z $((s * 2)) $((s * 2)) "$icon" --out "$tmp/i.iconset/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns "$tmp/i.iconset" -o "$tmp/x.app/Contents/Resources/AppIcon.icns"
  fi
  # UNNotificationSound only finds sounds inside the bundle. APFS clones cost no space but fail
  # across volumes, so fall back to a plain copy.
  cp -c /System/Library/Sounds/*.aiff "$tmp/x.app/Contents/Resources/" 2>/dev/null ||
    cp /System/Library/Sounds/*.aiff "$tmp/x.app/Contents/Resources/"
  plist="$tmp/x.app/Contents/Info.plist"
  plutil -create xml1 "$plist"
  plutil -insert CFBundleExecutable -string hookbell "$plist"
  plutil -insert CFBundleIdentifier -string "local.hookbell.$2" "$plist"
  plutil -insert CFBundleName -string "$name" "$plist"
  plutil -insert CFBundleDisplayName -string "$name" "$plist"
  plutil -insert CFBundleIconFile -string AppIcon "$plist"
  plutil -insert CFBundlePackageType -string APPL "$plist"
  plutil -insert CFBundleShortVersionString -string "$VERSION" "$plist"
  plutil -insert CFBundleVersion -string "$VERSION" "$plist"
  plutil -insert LSUIElement -bool true "$plist"
  plutil -insert NSAppleEventsUsageDescription -string "Jumps to the terminal tab that sent the notification." "$plist"
  [ ! -d "$app" ] || "$LSREGISTER" -u "$app"
  rm -rf "$app"
  mv "$tmp/x.app" "$app"
  sign "$app"
  echo "added $2 ($app)"
  # The permission prompt needs someone to answer it; non-interactive runs (CI) skip it.
  if [ -t 0 ]; then "$0" authorize "$2"; else echo "run 'hookbell authorize $2' to allow notifications"; fi
  ;;
authorize)
  check_id "${2:-}"
  [ -x "$(binary "$2")" ] || die "unknown source '$2'"
  echo "Allow notifications for '$2' in the prompt (waits up to 5 min)..."
  if "$(binary "$2")" --authorize; then echo "authorized"; else die "not authorized; enable it in System Settings > Notifications"; fi
  ;;
hooks)
  [ -n "${2:-}" ] || die "usage: hookbell hooks <codex|claude-code|gemini|agy|all>"
  selected="$(select_tools hooks "${@:2}")"
  [ -n "$selected" ] || die "none of ${TOOLS[*]} is installed"
  for tool in $selected; do
    tool_info "$tool" >/dev/null
    IFS='|' read -r name app_id <<<"$(tool_info "$tool")"
    [ -d "$(bundle "$tool")" ] || "$0" add "$tool" "$name" "$(app_icon "$app_id")"
    patch_config install "$tool"
  done
  ;;
unhook)
  [ -n "${2:-}" ] || die "usage: hookbell unhook <codex|claude-code|gemini|agy|all>"
  for tool in $(select_tools unhook "${@:2}"); do
    tool_info "$tool" >/dev/null
    patch_config remove "$tool"
  done
  ;;
remove)
  check_id "${2:-}"
  app="$(bundle "$2")"
  [ -d "$app" ] || die "unknown source '$2'"
  "$LSREGISTER" -u "$app"
  rm -rf "$app"
  echo "removed $2"
  ;;
uninstall)
  for tool in "${TOOLS[@]}"; do patch_config remove "$tool" || true; done
  for app in "$ROOT"/Sources/*.app; do
    [ -d "$app" ] && "$LSREGISTER" -u "$app"
  done
  rm -rf "$ROOT"
  [ "$(readlink "$CLI" || true)" != "$REPO/hookbell" ] || rm "$CLI"
  echo "uninstalled hookbell; notification settings stay in System Settings > Notifications"
  ;;
list)
  for app in "$ROOT"/Sources/*.app; do
    [ -d "$app" ] || continue
    echo "$(basename "$app" .app)  $(plutil -extract CFBundleDisplayName raw "$app/Contents/Info.plist")"
  done
  ;;
version | --version | -v)
  echo "hookbell $VERSION"
  ;;
*)
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
  [ -z "${1:-}" ] || [ "$1" = help ] || [ "$1" = --help ] || exit 1
  ;;
esac
