#!/bin/bash
# agent-notify: native macOS notifications per source (own name + icon) with click-to-focus.
#   agent-notify send <source> --title T [--body B] [...]   options: see main.swift
#   agent-notify add <source> <display-name> <icon.png|.icns>
#   agent-notify authorize <source> | remove <source> | list | install
set -euo pipefail

ROOT="$HOME/Library/Application Support/AgentNotify"
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister

die() { echo "agent-notify: $*" >&2; exit 1; }
check_id() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || die "invalid source id '${1:-}' (a-z, 0-9, -)"; }
bundle() { echo "$ROOT/Sources/$1.app"; }
sign() { codesign --force --sign - "$1" >/dev/null 2>&1 && "$LSREGISTER" -f "$1"; }

[ "$(id -u)" -ne 0 ] || die "do not run as root"

case "${1:-}" in
send)
  check_id "${2:-}"
  bin="$(bundle "$2")/Contents/MacOS/agent-notify"
  [ -x "$bin" ] || die "unknown source '$2'; add it with: agent-notify add $2 <name> <icon>"
  shift 2
  exec "$bin" "$@"
  ;;
install)
  mkdir -p "$ROOT/Sources" "$HOME/.local/bin"
  swiftc -O -o "$ROOT/agent-notify.new" "$REPO/main.swift"
  mv "$ROOT/agent-notify.new" "$ROOT/agent-notify"
  for app in "$ROOT"/Sources/*.app; do
    [ -d "$app" ] || continue
    cp "$ROOT/agent-notify" "$app/Contents/MacOS/agent-notify"
    sign "$app"
  done
  ln -sf "$REPO/agent-notify" "$HOME/.local/bin/agent-notify"
  echo "installed $ROOT/agent-notify"
  ;;
add)
  check_id "${2:-}"
  name="${3:-}" icon="${4:-}"
  [ -n "$name" ] || die "display name missing"
  [ -f "$icon" ] || die "icon not found: $icon"
  [ -x "$ROOT/agent-notify" ] || die "run 'agent-notify install' first"
  app="$(bundle "$2")"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  mkdir -p "$tmp/x.app/Contents/MacOS" "$tmp/x.app/Contents/Resources"
  cp "$ROOT/agent-notify" "$tmp/x.app/Contents/MacOS/agent-notify"
  if [[ "$icon" == *.icns ]]; then
    cp "$icon" "$tmp/x.app/Contents/Resources/AppIcon.icns"
  else
    mkdir "$tmp/i.iconset"
    for s in 16 32 128 256 512; do
      sips -s format png -z "$s" "$s" "$icon" --out "$tmp/i.iconset/icon_${s}x${s}.png" >/dev/null
      sips -s format png -z $((s * 2)) $((s * 2)) "$icon" --out "$tmp/i.iconset/icon_${s}x${s}@2x.png" >/dev/null
    done
    iconutil -c icns "$tmp/i.iconset" -o "$tmp/x.app/Contents/Resources/AppIcon.icns"
  fi
  # UNNotificationSound only finds sounds inside the bundle; APFS clones cost no space.
  cp -c /System/Library/Sounds/*.aiff "$tmp/x.app/Contents/Resources/"
  plist="$tmp/x.app/Contents/Info.plist"
  plutil -create xml1 "$plist"
  plutil -insert CFBundleExecutable -string agent-notify "$plist"
  plutil -insert CFBundleIdentifier -string "local.agent-notify.source.$2" "$plist"
  plutil -insert CFBundleName -string "$name" "$plist"
  plutil -insert CFBundleDisplayName -string "$name" "$plist"
  plutil -insert CFBundleIconFile -string AppIcon "$plist"
  plutil -insert CFBundlePackageType -string APPL "$plist"
  plutil -insert CFBundleVersion -string 1 "$plist"
  plutil -insert LSUIElement -bool true "$plist"
  plutil -insert NSAppleEventsUsageDescription -string "Jumps to the iTerm2 session that sent the notification." "$plist"
  [ ! -d "$app" ] || "$LSREGISTER" -u "$app"
  rm -rf "$app"
  mv "$tmp/x.app" "$app"
  sign "$app"
  echo "added $app"
  "$0" authorize "$2"
  ;;
authorize)
  check_id "${2:-}"
  bin="$(bundle "$2")/Contents/MacOS/agent-notify"
  [ -x "$bin" ] || die "unknown source '$2'"
  echo "Allow notifications for '$2' in the prompt (waits up to 5 min)..."
  "$bin" --authorize && echo "authorized" || die "not authorized; enable it in System Settings > Notifications"
  ;;
remove)
  check_id "${2:-}"
  app="$(bundle "$2")"
  [ -d "$app" ] || die "unknown source '$2'"
  "$LSREGISTER" -u "$app"
  rm -rf "$app"
  echo "removed $2"
  ;;
list)
  for app in "$ROOT"/Sources/*.app; do
    [ -d "$app" ] || continue
    echo "$(basename "$app" .app)  $(plutil -extract CFBundleDisplayName raw "$app/Contents/Info.plist")"
  done
  ;;
*)
  sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
  [ -z "${1:-}" ] || exit 1
  ;;
esac
